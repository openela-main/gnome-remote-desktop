+static LONG
+grd_pcscd_proxy_connect (SCARDCONTEXT  hContext,
+                         LPCSTR        szReader,
+                         DWORD         dwShareMode,
+                         DWORD         dwPreferredProtocols,
+                         LPSCARDHANDLE phCard,
+                         LPDWORD       pdwActiveProtocol)
+{
+  g_autoptr (GVariant) ret = NULL;

From 038e74fd2d088fb62bc37a629c3435f08aa6bcab Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Tue, 30 Jun 2026 12:55:39 +0200
Subject: [PATCH 1/2] vnc/tls: Forward EINTR and ECONTINUE to caller

This avoids a busy loop without falling back to poll().

Related: CVE-2026-109832
---
 src/grd-vnc-tls.c | 31 +++++++++++++++++--------------
 1 file changed, 17 insertions(+), 14 deletions(-)

diff --git a/src/grd-vnc-tls.c b/src/grd-vnc-tls.c
index 312b6b92..f3ef1efe 100644
--- a/src/grd-vnc-tls.c
+++ b/src/grd-vnc-tls.c
@@ -198,28 +198,31 @@ do_read (GrdVncTlsSession *tls_session,
          char             *buf,
          int               len)
 {
-  do
-    {
-      int ret;
+  ssize_t ret;
 
-      ret = gnutls_record_recv (tls_session->tls_session, buf, len);
-      if (ret == GNUTLS_E_AGAIN ||
-          ret == GNUTLS_E_INTERRUPTED)
+  ret = gnutls_record_recv (tls_session->tls_session, buf, len);
+  switch (ret)
+    {
+    case GNUTLS_E_AGAIN:
+      errno = EAGAIN;
+      return -1;
+    case GNUTLS_E_INTERRUPTED:
+      errno = EINTR;
+      return -1;
+    case GNUTLS_E_PREMATURE_TERMINATION:
+      errno = ECONNRESET;
+      return -1;
+    default:
+      if (ret >= 0)
         {
-          continue;
+          return (int) ret;
         }
-      else if (ret < 0)
+      else
         {
-          g_debug ("gnutls_record_recv failed: %s", gnutls_strerror (ret));
           errno = EIO;
           return -1;
         }
-      else
-        {
-          return ret;
-        }
     }
-  while (TRUE);
 }
 
 static int

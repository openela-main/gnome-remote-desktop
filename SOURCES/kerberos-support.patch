@@ -1504,8 +1569,7 @@ init_rdp_session (GrdSessionRdp  *session_rdp,
                                    session_rdp->sam_file->filename);
     }
 
-  if (auth_methods & GRD_RDP_AUTH_METHOD_KERBEROS &&

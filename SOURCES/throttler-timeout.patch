From e74e4e17a796a7b6946adfa512d287b71ff1a804 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Wed, 30 Sep 2026 23:37:43 +0200
Subject: [PATCH 12/13] vnc-server: Track sessions in a hash table

Just like for the RDP server, is the key the socket connection for the
client connection, and the value is the session. The key (connection) is
owned by the session, and the session is effectively owned by the hash
table.

When a session has stopped itself (e.g. client disconnect), we notify
the server about it, and it will move the session to a to-close list
freed in an idle callback, just as before. When stopping a session for
some other reason (e.g. tear down), we instead disconnect the signal
handlers, and handle the freeing without any idle callback. This is done
so that we can rely on removing a hash table entry to both stop and free
a session.

Part-of: <https://gitlab.gnome.org/GNOME/gnome-remote-desktop/-/merge_requests/436>
(cherry picked from commit b3ff0f961a57727182214fccc46188192e1e367f)
(cherry picked from commit dc69b9dd6cce966cf247d9f722f7525ddc88c863)
(cherry picked from commit 54031cd04110e874966492297615cb822a1ffea7)
---
 src/grd-session-vnc.c |  4 +++-
 src/grd-vnc-server.c  | 54 +++++++++++++++++++++++++++++--------------
 2 files changed, 40 insertions(+), 18 deletions(-)

diff --git a/src/grd-session-vnc.c b/src/grd-session-vnc.c
index 6980bcb9..16c199d6 100644
--- a/src/grd-session-vnc.c
+++ b/src/grd-session-vnc.c
@@ -807,6 +807,7 @@ grd_session_vnc_dispose (GObject *object)
   g_clear_pointer (&session_vnc->socket_grabs, g_list_free);
 
   g_clear_pointer (&session_vnc->pressed_keys, g_hash_table_unref);
+  g_clear_object (&session_vnc->connection);
 
   G_OBJECT_CLASS (grd_session_vnc_parent_class)->dispose (object);
 }
@@ -822,7 +823,8 @@ grd_session_vnc_stop (GrdSession *session)
 
   grd_session_vnc_pause (session_vnc);
 
-  g_clear_object (&session_vnc->connection);
+  g_io_stream_close (G_IO_STREAM (session_vnc->connection), NULL, NULL);
+
   g_clear_object (&session_vnc->clipboard_vnc);
   g_clear_pointer (&session_vnc->rfb_screen->frameBuffer, g_free);
   g_clear_pointer (&session_vnc->rfb_screen, rfbScreenCleanup);
diff --git a/src/grd-vnc-server.c b/src/grd-vnc-server.c
index c307f9c5..dfb2017a 100644
--- a/src/grd-vnc-server.c
+++ b/src/grd-vnc-server.c
@@ -48,7 +48,7 @@ struct _GrdVncServer
 
   GrdThrottler *throttler;
 
-  GList *sessions;
+  GHashTable *sessions;
 
   GList *stopped_sessions;
   guint idle_task;
@@ -100,11 +100,18 @@ cleanup_stopped_sessions_idle (GrdVncServer *vnc_server)
 static void
 on_session_stopped (GrdSession *session, GrdVncServer *vnc_server)
 {
+  GSocketConnection *connection;
+  gboolean stole;
+
   g_debug ("VNC session stopped");
 
   vnc_server->stopped_sessions = g_list_append (vnc_server->stopped_sessions,
                                                 session);
-  vnc_server->sessions = g_list_remove (vnc_server->sessions, session);
+
+  connection = grd_session_vnc_get_socket_connection (GRD_SESSION_VNC (session));
+  stole = g_hash_table_steal (vnc_server->sessions, connection);
+  g_assert (stole);
+
   if (!vnc_server->idle_task)
     {
       vnc_server->idle_task =
@@ -121,7 +128,7 @@ allow_connection_cb (GrdThrottler      *throttler,
   GrdVncServer *vnc_server = GRD_VNC_SERVER (user_data);
   GrdSessionVnc *session_vnc;
 
-  if (vnc_server->sessions)
+  if (g_hash_table_size (vnc_server->sessions) >= 1)
     {
       /* TODO: Add the rfbScreen instance to GrdVncServer to support multiple
        * sessions. */
@@ -132,7 +139,7 @@ allow_connection_cb (GrdThrottler      *throttler,
   g_debug ("Creating new VNC session");
 
   session_vnc = grd_session_vnc_new (vnc_server, connection);
-  vnc_server->sessions = g_list_append (vnc_server->sessions, session_vnc);
+  g_hash_table_insert (vnc_server->sessions, connection, session_vnc);
   grd_context_add_session (vnc_server->context, GRD_SESSION (session_vnc));
 
   g_signal_connect (session_vnc, "stopped",
@@ -205,13 +212,6 @@ grd_vnc_server_start (GrdVncServer  *vnc_server,
   return TRUE;
 }
 
-static void
-stop_and_unref_session (GrdSession *session)
-{
-  grd_session_stop (session);
-  g_object_unref (session);
-}
-
 static void
 grd_vnc_server_set_property (GObject      *object,
                              guint         prop_id,
@@ -264,18 +264,34 @@ grd_vnc_server_dispose (GObject *object)
     {
       grd_vnc_server_cleanup_stopped_sessions (vnc_server);
     }
-  if (vnc_server->sessions)
-    {
-      g_list_free_full (vnc_server->sessions,
-                        (GDestroyNotify) stop_and_unref_session);
-      vnc_server->sessions = NULL;
-    }
+  g_clear_pointer (&vnc_server->sessions, g_hash_table_unref);
 
   g_clear_object (&vnc_server->throttler);
 
   G_OBJECT_CLASS (grd_vnc_server_parent_class)->dispose (object);
 }
 
+static void
+grd_vnc_server_finalize (GObject *object)
+{
+  GrdVncServer *vnc_server = GRD_VNC_SERVER (object);
+
+  g_clear_pointer (&vnc_server->sessions, g_hash_table_unref);
+
+  G_OBJECT_CLASS (grd_vnc_server_parent_class)->finalize (object);
+}
+
+static void
+stop_session (gpointer user_data)
+{
+  GrdSessionVnc *session_vnc = GRD_SESSION_VNC (user_data);
+  GrdVncServer *vnc_server = grd_session_vnc_get_server (session_vnc);
+
+  g_signal_handlers_disconnect_by_data (session_vnc, vnc_server);
+  grd_session_stop (GRD_SESSION (session_vnc));
+  g_object_unref (session_vnc);
+}
+
 static void
 grd_vnc_server_constructed (GObject *object)
 {
@@ -293,6 +309,9 @@ grd_vnc_server_constructed (GObject *object)
                     vnc_server);
   sync_encryption_settings (vnc_server);
 
+  vnc_server->sessions = g_hash_table_new_full (NULL, NULL,
+                                                NULL, stop_session);
+
   limits = grd_throttler_limits_new (vnc_server->context);
   /* TODO: Add the rfbScreen instance to GrdVncServer to support multiple
    * sessions. */
@@ -317,6 +336,7 @@ grd_vnc_server_class_init (GrdVncServerClass *klass)
   object_class->set_property = grd_vnc_server_set_property;
   object_class->get_property = grd_vnc_server_get_property;
   object_class->dispose = grd_vnc_server_dispose;
+  object_class->finalize = grd_vnc_server_finalize;
   object_class->constructed = grd_vnc_server_constructed;
 
   g_object_class_install_property (object_class,

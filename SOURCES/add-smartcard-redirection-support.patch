index aa45ac2f..0cc3e942 100644
--- a/src/grd-pcscd-session.c
+++ b/src/grd-pcscd-session.c
@@ -27,10 +27,12 @@
 #include <gio/gunixinputstream.h>
 #include <gio/gunixoutputstream.h>
 #include <glib/gstdio.h>

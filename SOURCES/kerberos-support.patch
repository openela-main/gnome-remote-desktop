 src/grd-ctl.c                                 | 63 +++++++++++++++++++
 src/grd-daemon.c                              | 15 +++++
 src/grd-enums.h                               |  5 ++
 src/grd-settings-headless.c                   |  3 +
 src/grd-settings-user.c                       |  3 +
 src/grd-settings.c                            | 18 ++++++
 src/org.gnome.RemoteDesktop.xml               |  2 +
 ...nome.desktop.remote-desktop.gschema.xml.in | 18 ++++++
 9 files changed, 130 insertions(+)


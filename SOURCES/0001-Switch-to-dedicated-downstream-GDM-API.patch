From 2e534fb3c149f87d143377f3baa208745c22c73a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Fri, 21 Aug 2026 11:52:21 +0200
Subject: [PATCH] Switch to dedicated downstream GDM API

In the interface org.gnome.DisplayManager.RemoteDisplayFactory, the
used CreateRemoteDisplay is now called CreateRemoteDisplay2.
---
 src/grd-daemon-system.c          | 4 ++--
 src/org.gnome.DisplayManager.xml | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/grd-daemon-system.c b/src/grd-daemon-system.c
index 7befc18e..348bc52b 100644
--- a/src/grd-daemon-system.c
+++ b/src/grd-daemon-system.c
@@ -641,7 +641,7 @@ on_create_remote_display_finished (GObject      *object,
   GrdRemoteClient *remote_client = user_data;
   g_autoptr (GError) error = NULL;
 
-  if (!grd_dbus_gdm_remote_display_factory_call_create_remote_display_finish (
+  if (!grd_dbus_gdm_remote_display_factory_call_create_remote_display2_finish (
          proxy, result, &error))
     {
       g_warning ("[DaemonSystem] Error while calling CreateRemoteDisplay on "
@@ -750,7 +750,7 @@ on_incoming_new_connection (GrdRdpServer    *rdp_server,
            remote_client->id);
 
   properties_variant = serialize_remote_display_properties (remote_client);
-  grd_dbus_gdm_remote_display_factory_call_create_remote_display (
+  grd_dbus_gdm_remote_display_factory_call_create_remote_display2 (
     daemon_system->remote_display_factory_proxy,
     properties_variant,
     cancellable,
diff --git a/src/org.gnome.DisplayManager.xml b/src/org.gnome.DisplayManager.xml
index 14e61fdb..2e97f682 100644
--- a/src/org.gnome.DisplayManager.xml
+++ b/src/org.gnome.DisplayManager.xml
@@ -8,7 +8,7 @@
     </method>
   </interface>
   <interface name="org.gnome.DisplayManager.RemoteDisplayFactory">
-    <method name="CreateRemoteDisplay">
+    <method name="CreateRemoteDisplay2">
       <arg name="properties" direction="in" type="a{sv}"/>
     </method>
   </interface>
-- 
2.54.0


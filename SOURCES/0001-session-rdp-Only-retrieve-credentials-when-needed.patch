From 6459bcd8787a82f6f5862e092cbeae25766168a8 Mon Sep 17 00:00:00 2001
From: Tomas Pelka <tpelka@redhat.com>
Date: Fri, 9 Oct 2026 14:13:44 +0200
Subject: [PATCH] session-rdp: Only retrieve credentials when needed

When authenticating via Kerberos or when authentication is disabled
('none'), username and password credentials are not used by
gnome-remote-desktop.

Previously, init_rdp_session unconditionally called
grd_settings_get_rdp_credentials(), which in user session mode queries
libsecret / Secret Service. In environments where Secret Service fails
or is restricted (such as FIPS mode), this causes session initialization
to fail with an error even though credentials are not required for the
session.

Only retrieve RDP credentials if CREDENTIALS authentication is enabled
or if running in HANDOVER mode.

Resolves: https://redhat.atlassian.net/browse/RHEL-106950
Resolves: https://redhat.atlassian.net/browse/RHEL-3732
---
 src/grd-session-rdp.c | 24 ++++++++++++++----------
 1 file changed, 14 insertions(+), 10 deletions(-)

diff --git a/src/grd-session-rdp.c b/src/grd-session-rdp.c
index f8a2437..e3aa2cb 100644
--- a/src/grd-session-rdp.c
+++ b/src/grd-session-rdp.c
@@ -1517,16 +1517,6 @@ init_rdp_session (GrdSessionRdp  *session_rdp,
   rdpCertificate *rdp_certificate = NULL;
   rdpPrivateKey *rdp_private_key = NULL;
 
-  grd_settings_get_rdp_credentials (settings,
-                                    &username, &password,
-                                    &local_error);
-  if (local_error)
-    {
-      g_propagate_prefixed_error (error, g_steal_pointer (&local_error),
-                                  "Couldn't retrieve RDP credentials: ");
-      return FALSE;
-    }
-
   use_client_configs = session_rdp->screen_share_mode ==
                        GRD_RDP_SCREEN_SHARE_MODE_EXTEND;
 
@@ -1561,6 +1551,20 @@ init_rdp_session (GrdSessionRdp  *session_rdp,
                 "rdp-auth-methods", &auth_methods,
                 NULL);
 
+  if ((auth_methods & GRD_RDP_AUTH_METHOD_CREDENTIALS) ||
+      grd_context_get_runtime_mode (context) == GRD_RUNTIME_MODE_HANDOVER)
+    {
+      grd_settings_get_rdp_credentials (settings,
+                                        &username, &password,
+                                        &local_error);
+      if (local_error)
+        {
+          g_propagate_prefixed_error (error, g_steal_pointer (&local_error),
+                                      "Couldn't retrieve RDP credentials: ");
+          return FALSE;
+        }
+    }
+
   if (auth_methods & GRD_RDP_AUTH_METHOD_CREDENTIALS)
     {
       if (!username || !password)
-- 
2.55.0


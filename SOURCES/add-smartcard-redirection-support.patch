@@ -405,6 +452,9 @@ on_smartcard_connect_complete (RdpdrServerContext  *rdpdr_context,
         (int64_t) smartcard_scard_handle_native_from_redir (&ret->hCard);
       active_protocol =
         EXTEND_32_TO_64 (convert_protocol_to_pcsc (ret->dwActiveProtocol));
+
+      if (card != 0)

+                           LPCVOID);
+  LONG (*SCardCancel) (SCARDCONTEXT);
+  LONG (*SCardGetAttrib) (SCARDHANDLE,
+                          DWORD,
+                          LPBYTE,
+                          LPDWORD);
+  LONG (*SCardSetAttrib) (SCARDHANDLE,
+                          DWORD,
+                          LPCBYTE,
+                          DWORD);
+} GrdPcscLibBackend;

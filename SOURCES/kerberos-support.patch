     }
 }
 
+static gboolean
+populate_pre_authenticated_user (GrdSessionRdp                     *session_rdp,
+                                 const SecPkgContext_AuthIdentity  *auth_identity,
+                                 GError                           **error)
+{
+  g_autofree struct passwd *pwd = NULL;
+  g_autofree char *principal_string = NULL;

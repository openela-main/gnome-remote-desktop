From 48a79f3ca9d577da2b2968601c6cc44d3144ffa2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Wed, 30 Sep 2026 23:51:17 +0200
Subject: [PATCH 12/12] throttler: Introduce authentication timeout

If a connection that got allowed through by the throttler isn't marked
as 'authenticated' by the throttler owner (i.e. VNC/RDP server), then
the session and connection is closed.

The timeout is currently set to 30 seconds.

CVE: CVE-2026-96541
Closes: https://gitlab.gnome.org/GNOME/gnome-remote-desktop/-/issues/356
Part-of: <https://gitlab.gnome.org/GNOME/gnome-remote-desktop/-/merge_requests/436>
(cherry picked from commit 9b4f5e370eb8a833b7e1f4c2a873681c625e4673)
(cherry picked from commit fbcd252ab86f77a1d74463f47aa1de8799ec9b85)
---
 src/grd-rdp-server.c |  22 +++++++
 src/grd-throttler.c  | 146 +++++++++++++++++++++++++++++++++++++++++++
 src/grd-throttler.h  |   4 ++
 src/grd-vnc-server.c |  28 +++++++++
 4 files changed, 200 insertions(+)

diff --git a/src/grd-rdp-server.c b/src/grd-rdp-server.c
index 7fb2372f..4309af93 100644
--- a/src/grd-rdp-server.c
+++ b/src/grd-rdp-server.c
@@ -180,6 +180,14 @@ on_session_post_connect (GrdSessionRdp *session_rdp,
   GrdRuntimeMode runtime_mode =
     grd_context_get_runtime_mode (rdp_server->context);
 
+  if (rdp_server->throttler)
+    {
+      GSocketConnection *connection;
+
+      connection = grd_session_rdp_get_socket_connection (session_rdp);
+      grd_throttler_notify_authenticated (rdp_server->throttler, connection);
+    }
+
   g_signal_emit (rdp_server, signals[INCOMING_NEW_CONNECTION], 0, session_rdp);
 
   grd_dbus_remote_desktop_rdp_server_emit_new_connection (rdp_server_iface);
@@ -565,6 +573,17 @@ grd_rdp_server_finalize (GObject *object)
   G_OBJECT_CLASS (grd_rdp_server_parent_class)->finalize (object);
 }
 
+static void
+on_connection_timed_out (GrdThrottler      *throttler,
+                         GSocketConnection *connection,
+                         GrdRdpServer      *rdp_server)
+{
+  gboolean removed;
+
+  removed = g_hash_table_remove (rdp_server->sessions, connection);
+  g_assert (removed);
+}
+
 static void
 stop_session (gpointer user_data)
 {
@@ -606,6 +625,9 @@ grd_rdp_server_constructed (GObject *object)
         grd_throttler_new (grd_throttler_limits_new (rdp_server->context),
                            allow_callback,
                            rdp_server);
+      g_signal_connect (rdp_server->throttler, "connection-timed-out",
+                        G_CALLBACK (on_connection_timed_out),
+                        rdp_server);
     }
 
   rdp_server->pending_binding_attempts = RDP_SERVER_N_BINDING_ATTEMPTS;
diff --git a/src/grd-throttler.c b/src/grd-throttler.c
index fdab7d93..9b25787b 100644
--- a/src/grd-throttler.c
+++ b/src/grd-throttler.c
@@ -29,6 +29,17 @@
 #define DEFAULT_MAX_PENDING_CONNECTIONS 5
 #define DEFAULT_MAX_ATTEMPTS_PER_SECOND 1000
 
+#define AUTHENTICATE_TIMEOUT_US s2us (30)
+
+enum
+{
+  CONNECTION_TIMED_OUT,
+
+  N_SIGNALS
+};
+
+static guint signals[N_SIGNALS];
+
 struct _GrdThrottlerLimits
 {
   int max_global_connections;
@@ -61,6 +72,7 @@ struct _GrdThrottler
   GHashTable *peers;
 
   GSource *delayed_connections_source;
+  GSource *auth_timeout_source;
 };
 
 G_DEFINE_TYPE (GrdThrottler, grd_throttler, G_TYPE_OBJECT)
@@ -70,6 +82,14 @@ static GQuark quark_connection_data;
 static void
 maybe_queue_timeout (GrdThrottler *throttler);
 
+static void
+maybe_queue_auth_timeout (GrdThrottler *throttler);
+
+static void
+grd_throttler_unregister_connection (GrdThrottler      *throttler,
+                                     GSocketConnection *connection,
+                                     GrdPeer           *peer);
+
 static void
 prune_old_timestamps (GArray  *timestamps,
                       int64_t  now_us)
@@ -129,6 +149,8 @@ grd_throttler_register_connection (GrdThrottler      *throttler,
 
   prune_old_timestamps (peer->connect_timestamps, now_us);
   g_array_append_val (peer->connect_timestamps, now_us);
+
+  maybe_queue_auth_timeout (throttler);
 }
 
 static void
@@ -157,7 +179,9 @@ typedef struct _ConnectionData
 {
   GrdThrottler *throttler;
   char *peer_name;
+  int64_t connect_time_us;
   GSocketConnection *connection;
+  gboolean is_authenticated;
 } ConnectionData;
 
 static void
@@ -194,6 +218,7 @@ grd_throttler_allow_connection (GrdThrottler      *throttler,
   g_set_weak_pointer (&connection_data->throttler, throttler);
   connection_data->connection = connection;
   connection_data->peer_name = g_strdup (peer->name);
+  connection_data->connect_time_us = g_get_monotonic_time ();
 
   throttler->allow_callback (throttler, connection, throttler->user_data);
 
@@ -467,6 +492,118 @@ grd_throttler_handle_connection (GrdThrottler      *throttler,
   maybe_delay_connection (throttler, connection, peer, now_us);
 }
 
+static gboolean
+dispatch_auth_timeout (gpointer user_data)
+{
+  GrdThrottler *throttler = GRD_THROTTLER (user_data);
+  GHashTableIter iter;
+  gpointer key, value;
+  int64_t now_us;
+
+  now_us = g_get_monotonic_time ();
+
+  g_hash_table_iter_init (&iter, throttler->peers);
+  while (g_hash_table_iter_next (&iter, &key, &value))
+    {
+      GrdPeer *peer = value;
+      int i;
+
+      for (i = 0; i < peer->active_connections->len; i++)
+        {
+          GSocketConnection *connection =
+            g_ptr_array_index (peer->active_connections, i);
+          ConnectionData *connection_data;
+
+          connection_data = g_object_get_qdata (G_OBJECT (connection),
+                                                quark_connection_data);
+          if (connection_data->is_authenticated)
+            continue;
+
+          if (connection_data->connect_time_us + AUTHENTICATE_TIMEOUT_US <
+              now_us)
+            {
+              g_debug ("[Throttler] Connection from %s timeout out",
+                       peer->name);
+              g_signal_emit (throttler, signals[CONNECTION_TIMED_OUT], 0,
+                             connection);
+            }
+        }
+    }
+
+  maybe_queue_auth_timeout (throttler);
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+ensure_auth_timeout_source (GrdThrottler *throttler)
+{
+  if (throttler->auth_timeout_source)
+    return;
+
+  throttler->auth_timeout_source = g_source_new (&source_funcs,
+                                                 sizeof (GSource));
+  g_source_set_callback (throttler->auth_timeout_source,
+                         dispatch_auth_timeout, throttler, NULL);
+  g_source_attach (throttler->auth_timeout_source, NULL);
+  g_source_unref (throttler->auth_timeout_source);
+}
+
+static void
+maybe_queue_auth_timeout (GrdThrottler *throttler)
+{
+  GHashTableIter iter;
+  gpointer key, value;
+  int64_t next_timeout_us = INT64_MAX;
+
+  g_hash_table_iter_init (&iter, throttler->peers);
+  while (g_hash_table_iter_next (&iter, &key, &value))
+    {
+      GrdPeer *peer = value;
+      int i;
+
+      for (i = 0; i < peer->active_connections->len; i++)
+        {
+          GSocketConnection *connection =
+            g_ptr_array_index (peer->active_connections, i);
+          ConnectionData *connection_data;
+
+          connection_data = g_object_get_qdata (G_OBJECT (connection),
+                                                quark_connection_data);
+          if (connection_data->is_authenticated)
+            continue;
+
+          next_timeout_us = MIN (next_timeout_us,
+                                 connection_data->connect_time_us +
+                                 AUTHENTICATE_TIMEOUT_US);
+        }
+    }
+
+  if (next_timeout_us == INT64_MAX)
+    next_timeout_us = -1;
+
+  if (next_timeout_us >= 0)
+    {
+      ensure_auth_timeout_source (throttler);
+      g_source_set_ready_time (throttler->auth_timeout_source,
+                               next_timeout_us);
+    }
+}
+
+void
+grd_throttler_notify_authenticated (GrdThrottler      *throttler,
+                                    GSocketConnection *connection)
+{

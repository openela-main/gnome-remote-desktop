 grd_pcsc_lib_backend_cleanup_grd_pcscd_proxy (void)
 {
diff --git a/src/grd-rdp-smartcard.c b/src/grd-rdp-smartcard.c
index 746a7abb..c73858ad 100644
--- a/src/grd-rdp-smartcard.c

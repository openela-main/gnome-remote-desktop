From 0bb6dcb5d947579254a15576b9481464693db1be Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Wed, 2 Sep 2026 00:10:12 +0200
Subject: [PATCH 2/3] daemon-utils: Add helper to get a session ID from a pidfd

This is a race free variant of the equivalent that gets it from a pid.

Part-of: <https://gitlab.gnome.org/GNOME/gnome-remote-desktop/-/merge_requests/426>
---
 src/grd-daemon-utils.c | 16 ++++++++++++++++
 src/grd-daemon-utils.h |  2 ++
 2 files changed, 18 insertions(+)

diff --git a/src/grd-daemon-utils.c b/src/grd-daemon-utils.c
index f7df8507..7f82d452 100644
--- a/src/grd-daemon-utils.c
+++ b/src/grd-daemon-utils.c
@@ -116,6 +116,22 @@ grd_get_session_id_from_pid (pid_t pid)
   return session_id;
 }
 
+char *
+grd_get_session_id_from_pidfd (int pidfd)
+{
+  char *session_id = NULL;
+  int res;
+
+  res = sd_pidfd_get_session (pidfd, &session_id);
+  if (res < 0 && res != -ENODATA)
+    {
+      g_warning ("Failed to retrieve session information for "
+                 "pidfd %d: %s", pidfd, strerror (-res));
+    }
+
+  return session_id;
+}
+
 static gboolean
 grd_sd_session_is_graphical (const char *session_id)
 {
diff --git a/src/grd-daemon-utils.h b/src/grd-daemon-utils.h
index 19fe3d66..0777f106 100644
--- a/src/grd-daemon-utils.h
+++ b/src/grd-daemon-utils.h
@@ -35,6 +35,8 @@ gboolean grd_get_uid_of_sender_sync (GDBusConnection  *connection,
 
 char *grd_get_session_id_from_pid (pid_t pid);
 
+char * grd_get_session_id_from_pidfd (int pidfd);
+
 char *grd_get_session_id_from_uid (uid_t uid);
 
 char *grd_get_session_id_of_sender (GDBusConnection  *connection,
-- 

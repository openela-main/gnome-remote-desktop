From 8cf376a224308dbcc31a8f578e5426c2a06533b3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Mon, 21 Sep 2026 10:16:32 +0200
Subject: [PATCH] session/rdp: Allow 'none' authentication

When RDP is used from within a trusted network, or in any other way
access to the RDP port is restricted, one might want to avoid having to
perform any authentication to get access to a session. Allow this by
setting the authentication methods to 'none'. This Disables the NLA
security layer and just enables TLS security, i.e. server authentication
via certifcates only.

Setting authentication to 'none' is not recommended, but as mentioned,
can be useful especially when connecting from within a internal network
or VPN to access a login screen without having to provide the shared
credentials.

Closes: https://gitlab.gnome.org/GNOME/gnome-remote-desktop/-/work_items/29
---
 src/grd-ctl.c                                 | 53 ++++++++++++-------
 src/grd-daemon.c                              |  4 +-
 src/grd-enums.h                               |  1 +
 src/grd-session-rdp.c                         | 39 ++++++++++++--
 ...nome.desktop.remote-desktop.gschema.xml.in |  8 +++
 5 files changed, 78 insertions(+), 27 deletions(-)

diff --git a/src/grd-ctl.c b/src/grd-ctl.c
index 5953608e..62dfb206 100644
--- a/src/grd-ctl.c
+++ b/src/grd-ctl.c
@@ -262,36 +262,46 @@ rdp_set_auth_methods (GrdSettings  *settings,
                       GError      **error)
 {
   char *auth_methods_string = argv[0];
-  g_auto (GStrv) auth_method_strings = NULL;
-  char **auth_method;
   GrdRdpAuthMethods auth_methods = 0;
 
-  auth_method_strings = g_strsplit (auth_methods_string, ",", -1);
-  for (auth_method = auth_method_strings; *auth_method; auth_method++)
+  if (strcmp (auth_methods_string, "none") == 0)
     {
-      if (g_strcmp0 (*auth_method, "credentials") == 0)
-        {
-          auth_methods |= GRD_RDP_AUTH_METHOD_CREDENTIALS;
-        }
-      else if (g_strcmp0 (*auth_method, "kerberos") == 0)
+      auth_methods = GRD_RDP_AUTH_METHOD_NONE;
+      g_printerr ("With authentication disabled, make sure that the port is "
+                  "only exposed on a trusted network.\n");
+    }
+  else
+    {
+      g_auto (GStrv) auth_method_strings = NULL;
+      char **auth_method;
+
+      auth_method_strings = g_strsplit (auth_methods_string, ",", -1);
+      for (auth_method = auth_method_strings; *auth_method; auth_method++)
         {
-          auth_methods |= GRD_RDP_AUTH_METHOD_KERBEROS;
+          if (g_strcmp0 (*auth_method, "credentials") == 0)
+            {
+              auth_methods |= GRD_RDP_AUTH_METHOD_CREDENTIALS;
+            }
+          else if (g_strcmp0 (*auth_method, "kerberos") == 0)
+            {
+              auth_methods |= GRD_RDP_AUTH_METHOD_KERBEROS;
+            }
+          else
+            {
+              g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                           "Invalid auth method '%s'", *auth_method);
+              return FALSE;
+            }
         }
-      else
+
+      if (!auth_methods)
         {
           g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
-                       "Invalid auth method '%s'", *auth_method);
+                       "No auth method selected");
           return FALSE;
         }
     }
 
-  if (!auth_methods)
-    {
-      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
-                   "No auth method selected");
-      return FALSE;
-    }
-
   g_object_set (G_OBJECT (settings), "rdp-auth-methods", auth_methods, NULL);
   return TRUE;
 }
@@ -675,7 +685,7 @@ print_help (void)
       "    disable                                      - Disable the RDP backend\n"
       "    set-auth-methods <list-of-methods>           - Set a comma separated list of\n"
       "                                                   allowed authentication methods\n"
-      "                                                   (credentials, kerberos)\n"
+      "                                                   (credentials, kerberos) or none\n"
       "    set-tls-cert <path-to-cert>                  - Set path to TLS certificate\n"
       "    set-tls-key <path-to-key>                    - Set path to TLS key\n"
       "    set-kerberos-keytab <path-to-keytab>         - Set path to a Kerberos keytab\n"
@@ -791,6 +801,9 @@ generate_auth_methods_string (GrdRdpAuthMethods auth_methods)
   g_autoptr (GStrvBuilder) builder = NULL;
   g_auto (GStrv) auth_method_strings = NULL;
 
+  if (auth_methods == GRD_RDP_AUTH_METHOD_NONE)
+    return g_strdup ("none");
+
   builder = g_strv_builder_new ();
   if (auth_methods & GRD_RDP_AUTH_METHOD_CREDENTIALS)
     g_strv_builder_add (builder, "credentials");
diff --git a/src/grd-daemon.c b/src/grd-daemon.c
index dcdb425e..c1d2b69e 100644
--- a/src/grd-daemon.c
+++ b/src/grd-daemon.c
@@ -468,8 +468,8 @@ maybe_start_rdp_server (GrdDaemon *daemon)
 
   if (!auth_methods)
     {
-      g_warning ("No RDP auth methods configured, not enabling server.");
-      return;
+      g_message ("RDP user authentication disabled, make sure that the port is "
+                 "not exposed on the Internet.");
     }
 
   if (auth_methods & GRD_RDP_AUTH_METHOD_KERBEROS &&
diff --git a/src/grd-enums.h b/src/grd-enums.h
index b5793483..45438e54 100644
--- a/src/grd-enums.h
+++ b/src/grd-enums.h
@@ -54,6 +54,7 @@ typedef enum
 
 typedef enum
 {
+  GRD_RDP_AUTH_METHOD_NONE = 0,
   GRD_RDP_AUTH_METHOD_CREDENTIALS = 1 << 0,
   GRD_RDP_AUTH_METHOD_KERBEROS = 1 << 1,
 } GrdRdpAuthMethods;
diff --git a/src/grd-session-rdp.c b/src/grd-session-rdp.c
index 713a65fa..f8a2437f 100644
--- a/src/grd-session-rdp.c
+++ b/src/grd-session-rdp.c
@@ -1119,6 +1119,8 @@ rdp_peer_logon (freerdp_peer                  *peer,
   RdpPeerContext *rdp_peer_context = (RdpPeerContext *) rdp_context;
   GrdSessionRdp *session_rdp = rdp_peer_context->session_rdp;
   GrdContext *context = grd_session_get_context (GRD_SESSION (session_rdp));
+  GrdSettings *settings = grd_context_get_settings (context);
+  GrdRdpAuthMethods auth_methods = -1;
   GrdRdpAuthMethods auth_method;
   SECURITY_STATUS status;
   SecPkgContext_AuthIdentity auth_identity = {};
@@ -1126,7 +1128,15 @@ rdp_peer_logon (freerdp_peer                  *peer,
   if (grd_context_get_runtime_mode (context) == GRD_RUNTIME_MODE_HANDOVER)
     return TRUE;
 
-  auth_method = get_effective_auth_method (rdp_context);
+  g_object_get (G_OBJECT (settings),
+                "rdp-auth-methods", &auth_methods,
+                NULL);
+  g_assert (auth_methods != -1);
+
+  if (auth_methods == GRD_RDP_AUTH_METHOD_NONE)
+    auth_method = GRD_RDP_AUTH_METHOD_NONE;
+  else
+    auth_method = get_effective_auth_method (rdp_context);
 
   if (auth_method == -1)
     return FALSE;
@@ -1137,6 +1147,9 @@ rdp_peer_logon (freerdp_peer                  *peer,
       g_debug ("[RDP] Authenticated using NTLM, "
                "not applying any additional policy.");
       return TRUE;
+    case GRD_RDP_AUTH_METHOD_NONE:
+      g_debug ("[RDP] Allowing RDP session without authentication.");
+      return TRUE;
     case GRD_RDP_AUTH_METHOD_KERBEROS:
       break;
     }
@@ -1547,7 +1560,6 @@ init_rdp_session (GrdSessionRdp  *session_rdp,
   g_object_get (G_OBJECT (settings),
                 "rdp-auth-methods", &auth_methods,
                 NULL);
-  g_assert (auth_methods);
 
   if (auth_methods & GRD_RDP_AUTH_METHOD_CREDENTIALS)
     {
@@ -1613,14 +1625,31 @@ init_rdp_session (GrdSessionRdp  *session_rdp,
                                     rdp_private_key, 1);
 
   freerdp_settings_set_bool (rdp_settings, FreeRDP_RdpSecurity, FALSE);
-  freerdp_settings_set_bool (rdp_settings, FreeRDP_TlsSecurity, FALSE);
-  freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, TRUE);
 
-  if (grd_context_get_runtime_mode (context) == GRD_RUNTIME_MODE_HANDOVER)
+  switch (grd_context_get_runtime_mode (context))
     {
+    case GRD_RUNTIME_MODE_SCREEN_SHARE:
+    case GRD_RUNTIME_MODE_HEADLESS:
+    case GRD_RUNTIME_MODE_SYSTEM:
+      if (auth_methods)
+        {
+          freerdp_settings_set_bool (rdp_settings, FreeRDP_TlsSecurity, FALSE);
+          freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, TRUE);
+        }
+      else
+        {
+          freerdp_settings_set_bool (rdp_settings, FreeRDP_TlsSecurity, TRUE);
+          freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, FALSE);
+          freerdp_settings_set_bool (rdp_settings, FreeRDP_ExtSecurity, FALSE);
+          g_message ("[RDP] No authentication enabled");
+        }
+      break;
+    case GRD_RUNTIME_MODE_HANDOVER:
       freerdp_settings_set_string (rdp_settings, FreeRDP_Username, username);
       freerdp_settings_set_string (rdp_settings, FreeRDP_Password, password);
+      freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, TRUE);
       freerdp_settings_set_bool (rdp_settings, FreeRDP_RdstlsSecurity, TRUE);
+      break;
     }
 
   freerdp_settings_set_uint32 (rdp_settings, FreeRDP_OsMajorType,
diff --git a/src/org.gnome.desktop.remote-desktop.gschema.xml.in b/src/org.gnome.desktop.remote-desktop.gschema.xml.in
index 16945568..b41ea901 100644
--- a/src/org.gnome.desktop.remote-desktop.gschema.xml.in
+++ b/src/org.gnome.desktop.remote-desktop.gschema.xml.in
@@ -83,6 +83,10 @@
         Allowed authentication methods. Multiple may be selected to allow
         different authentication mechanisms. At least one authentication method
         must be selected.
+
+        If none is selected, then no authentication will be performed. Make sure
+        to protect the RDP service in some other way, for example using a
+        firewall, to avoid unauthorized access.
       </description>
     </key>
     <key name='kerberos-keytab' type='s'>
@@ -126,6 +130,10 @@
         Allowed authentication methods. Multiple may be selected to allow
         different authentication mechanisms. At least one authentication method
         must be selected.
+
+        If none is selected, then no authentication will be performed. Make sure
+        to protect the RDP service in some other way, for example using a
+        firewall, to avoid unauthorized access.
       </description>
     </key>
     <key name='kerberos-keytab' type='s'>

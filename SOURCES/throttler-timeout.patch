+  g_signal_connect (vnc_server->throttler, "connection-timed-out",
+                    G_CALLBACK (on_connection_timed_out),
+                    vnc_server);
 
   G_OBJECT_CLASS (grd_vnc_server_parent_class)->constructed (object);
 }

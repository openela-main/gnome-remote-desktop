+                       LPDWORD,
+                       LPBYTE,
+                       LPDWORD);
+  LONG (*SCardGetStatusChange) (SCARDCONTEXT,
+                                DWORD,
+                                SCARD_READERSTATE *,
+                                DWORD);
+  LONG (*SCardControl) (SCARDHANDLE,
+                        DWORD,
+                        LPCVOID,
+                        DWORD,
+                        LPVOID,
+                        DWORD,
+                        LPDWORD);
+  LONG (*SCardTransmit) (SCARDHANDLE,

From 6dadab1bc5c6b8dfa03258e7f0d705a3adadc75a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Fri, 23 Jan 2026 11:58:09 +0100
Subject: [PATCH 02/22] Allow authenticating single user runtime modes using
 Kerberos

This commit allows either changing the credentials based authentication
to using Kerberos, or using Kerberos in addition to the credentials
based authentication when running gnome-remote-desktop as a screen
sharing or single user RDP server.

What the Kerberos authentication does is enforcing that the
authenticated Kerberos principal maps to the same UID the server is
currently running as.

Part-of: <https://gitlab.gnome.org/GNOME/gnome-remote-desktop/-/merge_requests/369>
---
 meson.build                                   |   1 +
 src/grd-ctl.c                                 |  47 +++-
 src/grd-daemon.c                              |  13 +
 src/grd-enums.h                               |   1 +
 src/grd-session-rdp.c                         | 223 +++++++++++++++++-
 src/grd-settings-headless.c                   |   3 +
 src/grd-settings-user.c                       |   3 +
 src/grd-settings.c                            |  18 ++
 src/meson.build                               |   1 +
 src/org.gnome.RemoteDesktop.xml               |   2 +
 ...nome.desktop.remote-desktop.gschema.xml.in |  18 ++
 11 files changed, 318 insertions(+), 12 deletions(-)

diff --git a/meson.build b/meson.build
index 3b02e287..b6d29b83 100644
--- a/meson.build
+++ b/meson.build
@@ -29,6 +29,7 @@ libei_dep = dependency('libei-1.0', version: libei_req)
 libnotify_dep = dependency('libnotify')
 libsecret_dep = dependency('libsecret-1')
 libsystemd_dep = dependency('libsystemd', required: false)
+krb5_dep = dependency('krb5')
 pipewire_dep = dependency('libpipewire-0.3', version: '>= 1.2.0')
 systemd_dep = dependency('systemd', required: get_option('systemd'))
 tss2_esys_dep = dependency('tss2-esys')
diff --git a/src/grd-ctl.c b/src/grd-ctl.c

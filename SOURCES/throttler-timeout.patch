From 49d95f16b0843302317f66fbad30e31055e01681 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Tue, 29 Sep 2026 22:29:02 +0200
Subject: [PATCH 07/13] throttler: Replace global counter with function

The throttler instance has a list of peers, and each peer a list of
connections, so we already have a way to derive the count.

Part-of: <https://gitlab.gnome.org/GNOME/gnome-remote-desktop/-/merge_requests/436>
(cherry picked from commit 72c634cc92b2e7cadf1a847c0c56a7861c3ea177)
(cherry picked from commit 2aa4b9b967eb0ad427054dba835caa34b742561c)
(cherry picked from commit a8cfd92ed467dd226568522cf46c49e83b9138de)
---
 src/grd-throttler.c | 25 +++++++++++++++++++------
 1 file changed, 19 insertions(+), 6 deletions(-)

diff --git a/src/grd-throttler.c b/src/grd-throttler.c
index fd1a33dc..78116bd9 100644
--- a/src/grd-throttler.c
+++ b/src/grd-throttler.c
@@ -55,8 +55,6 @@ struct _GrdThrottler
 
   GrdThrottlerLimits *limits;
 
-  int active_connections;
-
   GrdThrottlerAllowCallback allow_callback;
   gpointer user_data;
 
@@ -119,7 +117,6 @@ grd_throttler_register_connection (GrdThrottler      *throttler,
   int64_t now_us;
 
   g_ptr_array_add (peer->active_connections, connection);
-  throttler->active_connections++;
 
   if (!peer->connect_timestamps)
     peer->connect_timestamps = g_array_new (FALSE, FALSE, sizeof (int64_t));
@@ -136,10 +133,8 @@ grd_throttler_unregister_connection (GrdThrottler      *throttler,
                                      GrdPeer           *peer)
 {
   g_assert (g_ptr_array_find (peer->active_connections, connection, NULL));
-  g_assert (throttler->active_connections > 0);
 
   g_ptr_array_remove (peer->active_connections, connection);
-  throttler->active_connections--;
 
   maybe_dispose_peer (throttler, peer, NULL);
   maybe_queue_timeout (throttler);
@@ -242,6 +237,24 @@ prune_closed_connections (GQueue *queue)
     }
 }
 
+static int
+count_active_connections (GrdThrottler *throttler)
+{
+  GHashTableIter iter;
+  gpointer key, value;
+  int count = 0;
+
+  g_hash_table_iter_init (&iter, throttler->peers);
+  while (g_hash_table_iter_next (&iter, &key, &value))
+    {
+      GrdPeer *peer = value;
+
+      count += peer->active_connections->len;
+    }
+
+  return count;
+}
+
 static gboolean
 is_connection_limit_reached (GrdThrottler *throttler,
                              GrdPeer      *peer)
@@ -251,7 +264,7 @@ is_connection_limit_reached (GrdThrottler *throttler,
   if (peer->active_connections->len >= limits->max_connections_per_peer)
     return TRUE;
 
-  if (throttler->active_connections >= limits->max_global_connections)
+  if (count_active_connections (throttler) >= limits->max_global_connections)
     return TRUE;
 
   return FALSE;
-- 
2.31.1



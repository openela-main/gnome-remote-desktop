@@ -584,10 +664,16 @@ on_handle_disconnect_card (GrdDBusPcscdSession   *skeleton,
   if (is_device_unavailable (smartcard, invocation))
     return G_DBUS_METHOD_INVOCATION_HANDLED;
 
